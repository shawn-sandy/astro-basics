{
  "name": "astro-basics-website",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "description": "Astro-based website demonstrating components and utilities",
  "author": "Shawn Sandy",
  "license": "MIT",
  "keywords": [
    "astro",
    "website",
    "content",
    "blog"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shawn-sandy/astro-basics"
  },
  "exports": {
    ".": "./src/components/index.ts",
    "./astro": "./src/components/astro"
  },
  "files": [
    "src/components/index.ts",
    "src/components/astro/*.astro"
  ],
  "scripts": {
    "dev": "astro dev --open",
    "start": "run-p dev sass",
    "build": "astro build",
    "preview": "astro preview",
    "deploy:preview": "npm run build && netlify deploy --dir=dist",
    "deploy:prod": "npm run build && netlify deploy --dir=dist --prod",
    "sass": "sass --watch src/styles/index.scss:src/styles/index.css --style=compressed",
    "astro": "astro",
    "pretest": "astro sync && mkdir -p .astro && cp node_modules/.astro/data-store.json .astro/data-store.json",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:axiom-login": "tsx scripts/test-axiom-login-logging.ts",
    "test:login-manual": "tsx scripts/manual-login-test.ts",
    "test:axiom-simple": "tsx scripts/simple-axiom-test.ts",
    "diagnose:axiom": "tsx scripts/diagnose-axiom.ts",
    "check:axiom": "tsx scripts/check-axiom-logs.ts",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "lint:styles": "stylelint 'src/**/*.{css,scss}'",
    "lint:styles:fix": "stylelint 'src/**/*.{css,scss}' --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "lint:md": "markdownlint '**/*.md' --ignore node_modules",
    "lint:md:fix": "markdownlint '**/*.md' --ignore node_modules --fix",
    "lint:all": "npm run lint:check && npm run lint:styles && npm run format:check && npm run type-check && npm run lint:md",
    "fix:all": "npm run lint && npm run lint:styles:fix && npm run format && npm run lint:md:fix",
    "db:setup": "node --env-file=.env scripts/setup-db.js",
    "db:wizard": "node --env-file=.env scripts/setup-wizard.js",
    "db:manage": "node --env-file=.env scripts/database-manager.js",
    "db:schema": "node --env-file=.env scripts/schema-validator.js",
    "db:reset": "node --env-file=.env scripts/setup-db.js --reset",
    "db:check": "node --env-file=.env scripts/setup-db.js --check",
    "db:seed:messages": "node --env-file=.env scripts/seed-messages.js",
    "db:migrate": "node scripts/migrate.js --up",
    "db:migrate:status": "node scripts/migrate.js --status",
    "db:migrate:create": "node scripts/migrate.js --create",
    "db:migrate:rollback": "node scripts/migrate.js --down",
    "db:status": "node --env-file=.env scripts/database-status.js",
    "db:switch": "node --env-file=.env scripts/switch-database.js",
    "db:switch:turso": "node --env-file=.env scripts/switch-database.js --to turso",
    "db:switch:supabase": "node --env-file=.env scripts/switch-database.js --to supabase",
    "db:switch:auto": "node --env-file=.env scripts/switch-database.js --to auto",
    "db:backup": "node --env-file=.env scripts/switch-database.js --backup-only",
    "db:restore": "node --env-file=.env scripts/switch-database.js --restore",
    "test:blog-comments": "node --env-file=.env scripts/test-blog-comments-schema.js",
    "test:comments-api": "node --env-file=.env scripts/test-comments-api.js",
    "test:webhook:duplicate-email": "node --env-file=.env scripts/testing/test-duplicate-email-webhook.js",
    "test:db:connection": "node --env-file=.env scripts/testing/test-db-connection.js",
    "test:db:abstraction": "node --env-file=.env scripts/testing/test-database-abstraction.js",
    "db:setup-users": "node --env-file=.env scripts/apply-user-migrations.js",
    "db:sync-user": "node --env-file=.env scripts/sync-current-user.js",
    "npm-update": "npx npm-check-updates -u",
    "npm-update-i": "npx npm-check-updates -i",
    "ticket:validate": "gh auth status && gh repo view && echo '✅ GitHub CLI ready for ticket creation'",
    "ticket:create": "gh issue create --web",
    "ticket:list": "gh issue list --state open",
    "ticket:labels": "gh label list",
    "setup:roles": "tsx scripts/setup-roles.ts",
    "setup:roles:dry-run": "tsx scripts/setup-roles.ts --dry-run",
    "validate:roles": "tsx -e \"import { validateRoleConfig } from './scripts/lib/role-validator.js'; import { roleConfig } from './config/roles.config.js'; const result = validateRoleConfig(roleConfig); if (!result.success) { console.error('Validation failed:', result.errors); process.exit(1); } console.log('✓ Configuration is valid!');\"",
    "prepare": "husky && patch-package"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "imports": {
    "#*": "./src/*"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astro-community/astro-embed-youtube": "^0.5.10",
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/netlify": "^8.0.0",
    "@astrojs/node": "^11.0.0",
    "@astrojs/react": "^6.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.2",
    "@astrojs/vercel": "^11.0.0",
    "@axiomhq/js": "^1.3.1",
    "@clerk/astro": "^3.0.23",
    "@fpkit/acss": "^6.0.0",
    "@fpkit/react": "^0.4.3",
    "@libsql/client": "^0.15.10",
    "@nanostores/react": "^1.0.0",
    "@spotlightjs/astro": "^2.2.2",
    "@supabase/supabase-js": "^2.53.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/react": "^18.2.69",
    "@types/react-dom": "^18.2.22",
    "astro": "^7.0.4",
    "astro-embed": "^0.13.0",
    "nanostores": "^1.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rehype-accessible-emojis": "^0.3.2",
    "remark-toc": "^9.0.0",
    "sharp": "^0.34.3",
    "svix": "^1.71.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.54.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.31.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "happy-dom": "^19.0.2",
    "husky": "^9.1.7",
    "inquirer": "^12.9.6",
    "lint-staged": "^16.1.2",
    "markdownlint-cli": "^0.45.0",
    "npm-run-all": "^4.1.5",
    "patch-package": "^8.0.1",
    "prettier": "^3.2.5",
    "prettier-plugin-astro": "^0.14.1",
    "sass": "^1.87.0",
    "stylelint": "^16.22.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "stylelint-order": "^7.0.0",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4",
    "zod": "^4.0.0"
  }
}
