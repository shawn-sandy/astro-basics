---
/**
 * OptionalSignedOut - Conditionally renders content for signed-out users
 * 
 * Shows content when authentication is enabled and user is signed out,
 * or when authentication is disabled (based on showWhenDisabled prop).
 */

import { isClerkEnabled } from '#utils/clerk-config'

export interface Props {
  showWhenDisabled?: boolean
  fallbackText?: string
  showFallback?: boolean
  class?: string
}

const { 
  showWhenDisabled = true,
  fallbackText = 'Please sign in', 
  showFallback = false,
  class: className = ''
} = Astro.props

// Check if user is authenticated (only works when Clerk is enabled)
const isAuthenticated = isClerkEnabled && Astro.locals.userId
---

{isClerkEnabled ? (
  !isAuthenticated ? (
    <div class={className}>
      <slot />
    </div>
  ) : showFallback ? (
    <div class={`auth-disabled ${className}`}>
      {fallbackText}
    </div>
  ) : null
) : showWhenDisabled ? (
  <div class={className}>
    <slot />
  </div>
) : showFallback ? (
  <div class={`auth-disabled ${className}`}>
    {fallbackText}
  </div>
) : null}

<style>
  .auth-disabled {
    opacity: 0.6;
    font-style: italic;
    color: var(--color-text-muted, #666);
  }
</style>