---
/**
 * OptionalSignedIn - Conditionally renders content for signed-in users
 * 
 * Shows content only when authentication is enabled and user is signed in,
 * otherwise renders nothing or a fallback.
 */

import { isClerkEnabled } from '#utils/clerk-config'

export interface Props {
  fallbackText?: string
  showFallback?: boolean
  class?: string
}

const { 
  fallbackText = 'Content available when signed in', 
  showFallback = false,
  class: className = ''
} = Astro.props

// Check if user is authenticated (only works when Clerk is enabled)
const isAuthenticated = isClerkEnabled && Astro.locals.userId
---

{isClerkEnabled ? (
  isAuthenticated ? (
    <div class={className}>
      <slot />
    </div>
  ) : showFallback ? (
    <div class={`auth-disabled ${className}`}>
      {fallbackText}
    </div>
  ) : null
) : showFallback ? (
  <div class={`auth-disabled ${className}`}>
    Authentication disabled
  </div>
) : null}

<style>
  .auth-disabled {
    opacity: 0.6;
    font-style: italic;
    color: var(--color-text-muted, #666);
    padding: 1rem;
    border: 1px dashed #ccc;
    border-radius: 4px;
    text-align: center;
  }
</style>