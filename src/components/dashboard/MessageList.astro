---
import type { MessageRow } from '#libs/turso'

export type Props = {
  messages: MessageRow[]
  classes?: string
}

const { messages, classes } = Astro.props
---

<ul class="messages-list messages" data-list="unstyled">
  <li>
    <p class="message-list">
      Found {messages.length} message{messages.length !== 1 ? 's' : ''}
    </p>
  </li>
  {
    messages.map(message => (
      <li data-message-id={message.id}>
        <h3>{message.subject}</h3>
        <p>
          <strong>From:</strong> {message.name}{' '}
          <a href={`mailto:${message.email}`}>{message.email}</a>
          <br />
          <strong>Date:</strong> {new Date(message.created_at).toLocaleString()}
        </p>
        <p>{message.message}</p>
        <hr />
      </li>
    ))
  }
</ul>

<style>
  .messages-list {
    max-width: 800px;
    margin: 0 auto;
    padding: 1rem;
    text-align: left;
  }

  .messages-list p {
    text-align: left;
  }

  .messages {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
</style>
