---
import DashboardIcon from '#components/dashboard/DashboardIcon.astro'
import { isDashboardIcon } from '#components/dashboard/icons'

/**
 * Recent activity as an ordered timeline: an icon, what happened, and when.
 *
 * `icon` takes a dashboard icon name (`file`, `eye`, `heart`…) and draws the
 * line icon; any other string, such as an emoji from an older caller, is shown
 * as text. The timestamp sits at the row's end when there is room and under the
 * text when there is not.
 *
 * @component ActivityFeed
 * @example
 * ```astro
 * <ActivityFeed activities={[{ icon: 'file', content: 'Post published', timestamp: '2 hours ago' }]} />
 * ```
 */
export type Props = {
  readonly activities: readonly {
    readonly icon: string
    readonly content: string
    readonly timestamp: string
  }[]
}

const { activities } = Astro.props
---

<div class="activity-feed">
  <ol class="activity-list" role="list">
    {
      activities.map(activity => (
        <li class="activity-item">
          <span class="activity-icon" aria-hidden="true">
            {isDashboardIcon(activity.icon) ? (
              <DashboardIcon name={activity.icon} size={16} />
            ) : (
              activity.icon
            )}
          </span>
          <p class="activity-content">{activity.content}</p>
          <small class="activity-time">{activity.timestamp}</small>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .activity-feed {
    container-type: inline-size;
  }

  .activity-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0 var(--space-4);
  }

  .activity-item {
    align-items: start;
    border-top: 1px solid var(--rule);
    column-gap: var(--space-3);
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    margin: 0;
    padding: var(--space-3-5) 0;
    row-gap: var(--space-0-5);
  }

  .activity-item:first-child {
    border-top: 0;
  }

  .activity-icon {
    align-items: center;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 50%;
    box-sizing: border-box;
    color: var(--ink-soft);
    display: flex;
    grid-row: span 2;
    height: 2rem;
    justify-content: center;
    width: 2rem;
  }

  .activity-content {
    margin: 0;
    max-width: none;
  }

  .activity-time {
    color: var(--ink-soft);
    font-size: var(--font-size-sm);
    white-space: nowrap;
  }

  @container (min-width: 32rem) {
    .activity-list {
      padding: 0 var(--space-5);
    }

    .activity-item {
      align-items: center;
      column-gap: var(--space-3-5);
      grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    }

    .activity-icon {
      grid-row: auto;
      height: 2.25rem;
      width: 2.25rem;
    }
  }
</style>
