---
import DashboardIcon from '#components/dashboard/DashboardIcon.astro'
import StatusPill from '#components/dashboard/StatusPill.astro'

/**
 * Recent posts as rows: title and excerpt, status, when it was updated, and an
 * optional edit link.
 *
 * Laid out as columns under a visual header when the component has room, and
 * stacked when it does not. It responds to its own width through a container
 * query, not the viewport's. The column header is decorative (`aria-hidden`):
 * each row's status and date read on their own, and the date carries a hidden
 * "Updated" prefix.
 *
 * @component PostPreview
 * @example
 * ```astro
 * <PostPreview posts={[{ title: 'Hello', excerpt: '…', status: 'Draft', date: 'Today', href: '/admin/posts' }]} />
 * ```
 */
export type Props = {
  readonly posts: readonly {
    readonly title: string
    readonly excerpt: string
    readonly status: 'Published' | 'Draft'
    readonly date: string
    /** Where the row's edit link goes. Omit for no edit link. */
    readonly href?: string
  }[]
}

const { posts } = Astro.props
---

<div class="post-list">
  <div class="post-list__head" aria-hidden="true">
    <span>Post</span>
    <span>Status</span>
    <span>Updated</span>
  </div>
  <ul class="post-list__items" role="list">
    {
      posts.map(post => (
        <li class="post-item">
          <div class="post-item__main">
            <span class="post-item__title">{post.title}</span>
            <span class="post-item__excerpt">{post.excerpt}</span>
          </div>
          <span class="post-item__status">
            <StatusPill tone={post.status === 'Published' ? 'success' : 'neutral'}>
              {post.status}
            </StatusPill>
          </span>
          <span class="post-item__date">
            <span class="sr-only">Updated </span>
            {post.date}
          </span>
          {post.href && (
            <a class="post-item__edit" href={post.href} aria-label={`Edit ${post.title}`}>
              <DashboardIcon name="edit" />
            </a>
          )}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .post-list {
    container-type: inline-size;
  }

  .post-list__head {
    display: none;
  }

  /* `role="list"` restores list semantics Safari drops with `list-style: none`. */
  .post-list__items {
    display: flex;
    flex-direction: column;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /*
   * Stacked: title and excerpt, then status, date and the edit link on one
   * line underneath.
   */
  .post-item {
    align-items: center;
    border-top: 1px solid var(--rule);
    column-gap: var(--space-3);
    display: grid;
    grid-template-areas:
      'main main main'
      'status date edit';
    grid-template-columns: auto minmax(0, 1fr) auto;
    margin: 0;
    padding: var(--space-4);
    row-gap: var(--space-2-5);
  }

  .post-item:first-child {
    border-top: 0;
  }

  .post-item__main {
    display: flex;
    flex-direction: column;
    gap: var(--space-0-5);
    grid-area: main;
    min-width: 0;
  }

  .post-item__title {
    font-weight: var(--font-weight-semibold);
  }

  .post-item__excerpt,
  .post-item__date {
    color: var(--ink-soft);
    font-size: var(--font-size-sm);
  }

  .post-item__status {
    grid-area: status;
  }

  .post-item__date {
    grid-area: date;
    white-space: nowrap;
  }

  /* `[href]` lifts the selector to (0,2,0), above the vendor's `a[href]`. */
  .post-item__edit[href] {
    align-items: center;
    border-radius: var(--radius-lg);
    color: var(--island);
    display: inline-flex;
    grid-area: edit;
    height: 44px;
    justify-content: center;
    margin: calc(var(--space-2-5) * -1) calc(var(--space-2) * -1);
    width: 44px;
  }

  .post-item__edit[href]:hover {
    background: var(--paper);
  }

  /* Columns once there is room, under the same track list as the header. */
  @container (min-width: 36rem) {
    .post-list__head,
    .post-item {
      grid-template-columns: minmax(0, 1fr) 8.5rem 7rem 2.75rem;
    }

    .post-list__head {
      border-bottom: 1px solid var(--rule);
      color: var(--ink-soft);
      column-gap: var(--space-3);
      display: grid;
      font-family: var(--font-family-mono);
      font-size: var(--font-size-xs);
      letter-spacing: 0.12em;
      padding: var(--space-3) var(--space-5);
      text-transform: uppercase;
    }

    .post-item {
      grid-template-areas: 'main status date edit';
      padding: var(--space-4) var(--space-5);
    }

    .post-item__edit[href] {
      margin: calc(var(--space-2) * -1) 0;
    }
  }
</style>
