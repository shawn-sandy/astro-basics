---
export const prerender = true
import Auth from '#/layouts/Auth.astro'
import { Show, SignUp } from '@clerk/astro/components'
---

<Auth pageTitle="Sign up - Astro Kit" hideHeader={true}>
  <section class="centered centered-column">
    <h2>Welcome!</h2>
    <p>Please sign up to continue.</p>
    <Show when="signed-out">
      <SignUp />
    </Show>
  </section>
</Auth>
