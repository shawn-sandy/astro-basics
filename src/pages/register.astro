---
export const prerender = true
import Auth from '#/layouts/Auth.astro'
import { OptionalSignedOut } from '#components/astro/auth'
---

<Auth pageTitle="Sign up - Astro Kit" hideHeader={true}>
  <section class="centered centered-column">
    <h2>Welcome!</h2>
    <p>Please sign up to continue.</p>
    <OptionalSignedOut>
      <div class="sign-up-placeholder">
        <p>Sign up functionality requires Clerk authentication to be enabled.</p>
        <p>Please configure your environment variables to enable authentication.</p>
      </div>
    </OptionalSignedOut>
  </section>
</Auth>
