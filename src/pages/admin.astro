---
import Auth from '#layouts/Auth.astro'
import { OptionalSignedIn, OptionalSignedOut, OptionalUserButton } from '#components/astro/auth'
import SignedOutMessage from '#/components/astro/SignedOutMessage.astro'
---

<Auth pageTitle="Admin - Astro Kit">
  <OptionalSignedIn>
    <div class="admin-container">
      <h1>Admin Dashboard</h1>
      <div class="admin-actions">
        <button class="action-button">Manage Users</button>
        <button class="action-button">View Reports</button>
        <button class="action-button">Settings</button>
      </div>
    </div>
  </OptionalSignedIn>
  <OptionalSignedOut>
    <SignedOutMessage
      title="Admin Access Required"
      message="Please sign in to access the admin dashboard."
    />
  </OptionalSignedOut>
</Auth>
