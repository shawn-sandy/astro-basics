---
import Layout from '#layouts/BaseLayout.astro'
import { MessagesList } from '#components/react/MessagesList'

const auth = Astro.locals.auth()
const { userId } = auth

if (!userId) {
  return Astro.redirect('/sign-in')
}
---

<Layout title="Forum - Astro Basics">
  <main class="container forum-page">
    <h1>Community Forum</h1>
    <p>Welcome to the community forum. Here you can view and manage your messages.</p>

    <section class="messages-section">
      <MessagesList client:load />
    </section>

    <section class="forum-actions">
      <h2>Quick Actions</h2>
      <div class="action-buttons">
        <a href="/forum/new-topic" class="btn btn-primary">Start New Topic</a>
        <a href="/forum/my-topics" class="btn">My Topics</a>
        <a href="/forum/settings" class="btn">Forum Settings</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .forum-page {
    padding: 2rem 0;
  }

  .messages-section {
    margin: 2rem 0;
    padding: 1.5rem;
    background: var(--color-bg-secondary, #f5f5f5);
    border-radius: 0.5rem;
  }

  .forum-actions {
    margin-top: 3rem;
  }

  .action-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .btn {
    padding: 0.75rem 1.5rem;
    background: var(--color-bg-tertiary, #e0e0e0);
    color: var(--color-text, #333);
    text-decoration: none;
    border-radius: 0.375rem;
    transition: background-color 0.2s;
  }

  .btn:hover {
    background: var(--color-bg-hover, #d0d0d0);
  }

  .btn-primary {
    background: var(--color-primary, #007bff);
    color: white;
  }

  .btn-primary:hover {
    background: var(--color-primary-hover, #0056b3);
  }

  @media (max-width: 768px) {
    .action-buttons {
      flex-direction: column;
    }

    .btn {
      text-align: center;
    }
  }
</style>
