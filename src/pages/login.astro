---
export const prerender = true
import Auth from '#/layouts/Auth.astro'
import { Show, SignIn } from '@clerk/astro/components'
---

<Auth pageTitle="Sign In - Astro Kit" hideHeader={true}>
  <section class="centered centered-column">
    <h2>Welcome Back!</h2>
    <p>Please sign in to continue.</p>
    <Show when="signed-out">
      <SignIn />
    </Show>
  </section>
</Auth>
