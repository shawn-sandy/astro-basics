---
import { getCollection, type CollectionEntry } from 'astro:content'
import { isCommentSystemLikelyAvailable } from '#utils/comments-availability'
import MarkdownPostLayout from '../../layouts/MarkdownPostLayout.astro'

// Disable prerendering if comment system (database) is available
// This allows access to authentication context for authenticated features
export const prerender = !isCommentSystemLikelyAvailable()

export async function getStaticPaths() {
  const docs = await getCollection('docs')
  return docs.map((entry: CollectionEntry<'docs'>) => ({
    params: { slug: entry.slug },
    props: { entry },
  }))
}

export type Props = {
  entry?: CollectionEntry<'docs'>
}

// Handle both static and dynamic rendering
let entry: CollectionEntry<'docs'>
if (Astro.props.entry) {
  // Static/prerendered context
  entry = Astro.props.entry
} else {
  // Server-rendered context - get entry from params
  const docs = await getCollection('docs')
  const foundEntry = docs.find(doc => doc.slug === Astro.params.slug)
  if (!foundEntry) {
    return Astro.redirect('/404')
  }
  entry = foundEntry
}

const { Content, headings } = await entry.render()
---

<MarkdownPostLayout frontmatter={entry.data} headings={headings}>
  <Content />
</MarkdownPostLayout>
