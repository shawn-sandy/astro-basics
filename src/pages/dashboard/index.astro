---
import Auth from '#/layouts/Auth.astro'
import { SignedIn, SignedOut, UserButton } from '@clerk/astro/components'
import {
  DashboardCard,
  DashboardLayout,
  StatsCards,
  ActivityFeed,
  QuickActions,
  PostPreview,
} from '#/components/dashboard'
import SignedOutMessage from '#/components/astro/SignedOutMessage.astro'
import UserInfo from '#/components/astro/UserInfo.astro'
import RoleGuard from '#components/astro/RoleGuard.astro'

// Dashboard data
const stats = [
  { title: 'Total Posts', value: '24' },
  { title: 'Views', value: '1,234' },
  { title: 'Subscribers', value: '89' },
  { title: 'Likes', value: '456' },
]

const activities = [
  {
    icon: '📝',
    content: 'New blog post published: "Getting Started with Astro"',
    timestamp: '2 hours ago',
  },
  {
    icon: '👀',
    content: 'Page views increased on "React Components in Astro"',
    timestamp: '5 hours ago',
  },
  {
    icon: '❤️',
    content: 'Post liked: "Building Modern Web Apps"',
    timestamp: '1 day ago',
  },
]

const actions = [
  {
    href: '/admin/posts/new',
    icon: '✏️',
    label: 'Create New Post',
    primary: true,
  },
  {
    href: '/admin/posts',
    icon: '📄',
    label: 'Manage Posts',
  },
  {
    href: '/admin/media',
    icon: '🖼️',
    label: 'Media Library',
  },
  {
    href: '/guide',
    icon: '📚',
    label: 'Developer Guides',
  },
  {
    href: '/admin/settings',
    icon: '⚙️',
    label: 'Settings',
  },
]

const posts = [
  {
    title: 'Getting Started with Astro Components',
    excerpt: 'A comprehensive guide to building reusable components...',
    status: 'Published' as const,
    date: '3 days ago',
  },
  {
    title: 'React Integration in Astro',
    excerpt: 'Learn how to seamlessly integrate React components...',
    status: 'Draft' as const,
    date: '1 week ago',
  },
]
---

<Auth pageTitle="Dashboard - Astro Kit" pageDescription="">
  <SignedIn>
    <div class="dashboard-container">
      <DashboardLayout columns="1fr 1fr" gap="2rem" className="dashboard-grid">
        <UserInfo />
        <div class="stats-section">
          <h2>Overview</h2>
          <StatsCards stats={stats} />
        </div>

        <DashboardCard title="Recent Activity">
          <ActivityFeed activities={activities} />
        </DashboardCard>

        <DashboardCard title="Quick Actions">
          <QuickActions actions={actions} />
        </DashboardCard>

        <DashboardCard title="Recent Posts">
          <PostPreview posts={posts} />
        </DashboardCard>
      </DashboardLayout>
      <RoleGuard allowedRoles={['member']}>
        <DashboardCard title="Member Panel Access" className="mt-4">
          <p>Access the member panel for advanced management features.</p>
          <div style="text-align: center; margin-top: 2rem;">
            <a href="/admin" class="btn btn-primary">Go to Member Panel</a>
          </div>
        </DashboardCard>
      </RoleGuard>
      <hr />
      <RoleGuard allowedRoles={['admin', `super_admin`]}>
        <DashboardCard title="Admin Panel Access" className="mt-4">
          <p>Access the admin panel for advanced management features.</p>
          <div style="text-align: center; margin-top: 2rem;">
            <a href="/admin" class="btn btn-primary">Go to Admin Panel</a>
          </div>
        </DashboardCard>
      </RoleGuard>
    </div>
  </SignedIn>

  <SignedOut>
    <SignedOutMessage />
  </SignedOut>
</Auth>

<style>
  .dashboard-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .profile-section {
    grid-column: 1 / -1;
  }

  .stats-section {
    grid-column: 1 / -1;
  }

  .stats-section h2 {
    margin: 0 0 1rem 0;
    color: #1a202c;
    font-size: 1.25rem;
  }

  @media (max-width: 768px) {
    .dashboard-container {
      padding: 1rem;
    }
  }
</style>
