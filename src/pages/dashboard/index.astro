---
import Auth from '#/layouts/Auth.astro'
import { OptionalSignedIn, OptionalSignedOut, AuthStatusBanner } from '#components/astro/auth'
import {
  DashboardCard,
  DashboardLayout,
  StatsCards,
  ActivityFeed,
  QuickActions,
  PostPreview,
} from '#/components/dashboard'
import SignedOutMessage from '#/components/astro/SignedOutMessage.astro'
import UserInfo from '#/components/astro/UserInfo.astro'
import { isClerkEnabled } from '#utils/clerk-config'

// Dashboard data
const stats = [
  { title: 'Total Posts', value: '24' },
  { title: 'Views', value: '1,234' },
  { title: 'Comments', value: '89' },
  { title: 'Likes', value: '456' },
]

const activities = [
  {
    icon: '📝',
    content: 'New blog post published: "Getting Started with Astro"',
    timestamp: '2 hours ago',
  },
  {
    icon: '💬',
    content: 'New comment on "React Components in Astro"',
    timestamp: '5 hours ago',
  },
  {
    icon: '❤️',
    content: 'Post liked: "Building Modern Web Apps"',
    timestamp: '1 day ago',
  },
]

const actions = [
  {
    href: '/admin/posts/new',
    icon: '✏️',
    label: 'Create New Post',
    primary: true,
  },
  {
    href: '/admin/posts',
    icon: '📄',
    label: 'Manage Posts',
  },
  {
    href: '/admin/media',
    icon: '🖼️',
    label: 'Media Library',
  },
  {
    href: '/admin/settings',
    icon: '⚙️',
    label: 'Settings',
  },
]

const posts = [
  {
    title: 'Getting Started with Astro Components',
    excerpt: 'A comprehensive guide to building reusable components...',
    status: 'Published' as const,
    date: '3 days ago',
  },
  {
    title: 'React Integration in Astro',
    excerpt: 'Learn how to seamlessly integrate React components...',
    status: 'Draft' as const,
    date: '1 week ago',
  },
]
---

<Auth pageTitle="Dashboard - Astro Kit" pageDescription="">
  {!isClerkEnabled ? (
    <div class="auth-disabled-container">
      <AuthStatusBanner 
        disabledMessage="Dashboard requires authentication to be enabled. Please configure Clerk environment variables." 
      />
      <div class="auth-disabled-content">
        <h2>Dashboard Unavailable</h2>
        <p>
          The dashboard requires authentication to function properly. 
          To enable the dashboard, please configure the following environment variables:
        </p>
        <ul>
          <li><code>PUBLIC_CLERK_PUBLISHABLE_KEY</code></li>
          <li><code>CLERK_SECRET_KEY</code></li>
        </ul>
        <p>
          <a href="/docs/authentication">View authentication setup documentation</a>
        </p>
      </div>
    </div>
  ) : (
    <>
      <OptionalSignedIn>
        <div class="dashboard-container">
          <DashboardLayout columns="1fr 1fr" gap="2rem" className="dashboard-grid">
            <DashboardCard title="Profile" className="profile-section">
              <UserInfo />
            </DashboardCard>

            <div class="stats-section">
              <h2>Overview</h2>
              <StatsCards stats={stats} />
            </div>

            <DashboardCard title="Recent Activity">
              <ActivityFeed activities={activities} />
            </DashboardCard>

            <DashboardCard title="Quick Actions">
              <QuickActions actions={actions} />
            </DashboardCard>

            <DashboardCard title="Recent Posts">
              <PostPreview posts={posts} />
            </DashboardCard>
          </DashboardLayout>
        </div>
      </OptionalSignedIn>

      <OptionalSignedOut>
        <SignedOutMessage />
      </OptionalSignedOut>
    </>
  )}
</Auth>

<style>
  .dashboard-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .profile-section {
    grid-column: 1 / -1;
  }

  .stats-section {
    grid-column: 1 / -1;
  }

  .stats-section h2 {
    margin: 0 0 1rem 0;
    color: #1a202c;
    font-size: 1.25rem;
  }

  .auth-disabled-container {
    max-width: 800px;
    margin: 2rem auto;
    padding: 2rem;
  }

  .auth-disabled-content {
    text-align: center;
    padding: 2rem;
    background: #f8f9fa;
    border-radius: 8px;
    border: 1px solid #e9ecef;
  }

  .auth-disabled-content h2 {
    color: #495057;
    margin-bottom: 1rem;
  }

  .auth-disabled-content p {
    color: #6c757d;
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .auth-disabled-content ul {
    text-align: left;
    display: inline-block;
    margin: 1rem 0;
    padding: 0;
    list-style: none;
  }

  .auth-disabled-content li {
    margin: 0.5rem 0;
    padding: 0.5rem 1rem;
    background: #fff;
    border: 1px solid #dee2e6;
    border-radius: 4px;
    font-family: monospace;
  }

  .auth-disabled-content code {
    background: #f1f3f4;
    padding: 0.2rem 0.4rem;
    border-radius: 3px;
    font-family: monospace;
  }

  @media (max-width: 768px) {
    .dashboard-container {
      padding: 1rem;
    }
    
    .auth-disabled-container {
      padding: 1rem;
    }
  }
</style>
