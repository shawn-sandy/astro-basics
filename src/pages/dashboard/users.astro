---
import Auth from '#layouts/Auth.astro'
import { OptionalSignedIn, OptionalSignedOut, AuthStatusBanner } from '#components/astro/auth'
import { isClerkEnabled } from '#utils/clerk-config'

// User profile functionality is disabled when Clerk is not enabled
---

<Auth title="User Management - Astro Basics">
  <main class="container dashboard-page">
    {!isClerkEnabled ? (
      <div class="auth-disabled-container">
        <AuthStatusBanner 
          disabledMessage="User management requires authentication to be enabled." 
        />
        <div class="auth-disabled-content">
          <h1>User Management Unavailable</h1>
          <p>This feature requires Clerk authentication to be properly configured.</p>
        </div>
      </div>
    ) : (
      <>
        <OptionalSignedIn>
          <div class="dashboard-header">
            <h1>User Management</h1>
          </div>

          <section class="user-actions">
            <h2>Manage Users</h2>
            <div class="feature-unavailable">
              <p>User profile management is not available when authentication is disabled</p>
            </div>
          </section>
        </OptionalSignedIn>

        <OptionalSignedOut>
          <div class="alert alert--info">
            <p>Please sign in to access the user management dashboard.</p>
            <a href="/login" class="btn btn--primary">Sign In</a>
          </div>
        </OptionalSignedOut>
      </>
    )}
  </main>
</Auth>

<style>
  .auth-disabled-container {
    max-width: 800px;
    margin: 2rem auto;
    padding: 2rem;
  }

  .auth-disabled-content {
    text-align: center;
    padding: 2rem;
    background: #f8f9fa;
    border-radius: 8px;
    border: 1px solid #e9ecef;
  }

  .feature-unavailable {
    padding: 1rem;
    background: #f8f9fa;
    border: 1px solid #dee2e6;
    border-radius: 4px;
    text-align: center;
    color: #6c757d;
  }
</style>
