---
import Auth from '#layouts/Auth.astro'
import MessageList from '#components/dashboard/MessageList.astro'
import { getMessages, isTursoConfigured, type MessageRow } from '#libs/turso'

let messages: MessageRow[] = []
let error: string | null = null

if (isTursoConfigured()) {
  try {
    messages = await getMessages({
      is_archived: false,
      limit: 50,
    })
  } catch (err) {
    error = err instanceof Error ? err.message : 'Failed to load messages'
    console.error('Error fetching messages:', err)
  }
} else {
  error = 'Database not configured'
}
---

<Auth
  hideHeader={false}
  showBreadcrumb={true}
  pageTitle="Message Center"
  pageDescription="Your message center overview"
>
  <section>
    {
      error ? (
        <div class="alert alert-error">
          <p>Error: {error}</p>
        </div>
      ) : messages.length === 0 ? (
        <p>No messages found.</p>
      ) : (
        <>
          <MessageList messages={messages} />
        </>
      )
    }
  </section>
</Auth>

<style>
  .message-count {
    max-width: 800px;
    margin: 0 auto;
    padding: 1rem;
    text-align: left;
  }

  .message-count p {
    text-align: left;
  }
</style>
