---
import Auth from '#layouts/Auth.astro'
import MessageList from '#components/dashboard/MessageList.astro'
import { getDatabase } from '#libs/database'
import type { Message } from '#libs/database-types'

let messages: Message[] = []
let error: string | null = null

try {
  const db = getDatabase()

  if (!db.isConfigured()) {
    error = 'Database not configured'
  } else {
    try {
      messages = await db.getMessages({
        archived: false,
        limit: 50,
      })
    } catch (err) {
      error = err instanceof Error ? err.message : 'Failed to load messages'
      console.error('Error fetching messages:', err)
    }
  }
} catch (initError) {
  error = 'Database service unavailable'
  console.error('Database initialization error:', initError)
}
---

<Auth
  hideHeader={false}
  showBreadcrumb={true}
  pageTitle="Message Center"
  pageDescription="Your message center overview"
>
  <section>
    {
      error ? (
        <div class="alert alert-error">
          <p>Error: {error}</p>
        </div>
      ) : messages.length === 0 ? (
        <p>No messages found.</p>
      ) : (
        <>
          <MessageList messages={messages} />
        </>
      )
    }
  </section>
</Auth>

<style>
  .message-count {
    max-width: 800px;
    margin: 0 auto;
    padding: 1rem;
    text-align: left;
  }

  .message-count p {
    text-align: left;
  }
</style>
