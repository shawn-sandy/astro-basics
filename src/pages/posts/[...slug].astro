---
import { getCollection, type CollectionEntry } from 'astro:content'
import { COMMENTS_AVAILABLE } from '#utils/comments-availability'
import MarkdownPostLayout from '#layouts/MarkdownPostLayout.astro'

// Conditionally disable prerendering if comments are enabled
// This allows access to authentication context for authenticated features
export const prerender = !COMMENTS_AVAILABLE

export async function getStaticPaths() {
  const posts = await getCollection('posts')
  return posts.map((entry: CollectionEntry<'posts'>) => ({
    params: { slug: entry.slug },
    props: { entry },
  }))
}

export type Props = {
  entry?: CollectionEntry<'posts'>
}

// Handle both static and dynamic rendering
let entry: CollectionEntry<'posts'>
if (Astro.props.entry) {
  // Static/prerendered context
  entry = Astro.props.entry
} else {
  // Server-rendered context - get entry from params
  const posts = await getCollection('posts')
  const foundEntry = posts.find(post => post.slug === Astro.params.slug)
  if (!foundEntry) {
    return Astro.redirect('/404')
  }
  entry = foundEntry
}

const { Content, headings } = await entry.render()
---

<MarkdownPostLayout frontmatter={entry.data} headings={headings}>
  <Content />
</MarkdownPostLayout>
