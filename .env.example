# Clerk Configuration (Required for authentication)
PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY
CLERK_WEBHOOK_SECRET=YOUR_CLERK_WEBHOOK_SECRET

# Supabase Configuration (Required for database features)
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# Public Supabase Keys (for client-side)
PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Adapter configuration - set to "node", "netlify", or "vercel"
# ASTRO_ADAPTER=netlify

# Turso Configuration
TURSO_DATABASE_URL=YOUR_TURSO_DATABASE_URL
TURSO_AUTH_TOKEN=YOUR_TURSO_AUTH_TOKEN

# PWA Configuration
PWA_ENABLED=false

# Comment System Configuration
ENABLE_COMMENTS=true
# Note: Comments require SUPABASE_URL and SUPABASE_ANON_KEY to be configured
# Run 'npm run db:migrate' to set up the comments table