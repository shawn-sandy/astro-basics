# Clerk Configuration (Required for authentication)
# Get these from: Clerk Dashboard → API Keys
# Dashboard: https://dashboard.clerk.com → [Your App] → API Keys
PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY  # Publishable Key (starts with pk_)
CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY                   # Secret Key (starts with sk_)
CLERK_WEBHOOK_SECRET=YOUR_CLERK_WEBHOOK_SECRET           # Webhooks → [Endpoint] → Signing Secret

# Supabase Configuration (Required for database features)
# Get these from: Supabase Dashboard → Settings → API
# Dashboard: https://supabase.com/dashboard → [Your Project] → Settings → API
SUPABASE_URL=YOUR_SUPABASE_URL                           # Project URL (top of API page)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY                 # Project API Keys → anon (public)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY # Project API Keys → service_role (secret)

# Public Supabase Keys (for client-side)
# Use the SAME values as above - these are safe for client-side code
PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL           # Same as SUPABASE_URL
PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY # Same as SUPABASE_ANON_KEY

# Note: SUPABASE_JWT_SECRET not needed for native Clerk integration (2025)

# Adapter configuration - set to "node", "netlify", or "vercel"
# ASTRO_ADAPTER=netlify

# Turso Configuration (Alternative to Supabase)
# Install Turso CLI: curl -sSfL https://get.tur.so/install.sh | bash
# Get URL: turso db show [db-name] --url
# Get Token: turso db tokens create [db-name]
TURSO_DATABASE_URL=YOUR_TURSO_DATABASE_URL  # libsql://your-db.turso.io
TURSO_AUTH_TOKEN=YOUR_TURSO_AUTH_TOKEN      # Auth token from CLI

# PWA Configuration
PWA_ENABLED=false

# Axiom Logging Configuration (Production logging service)
# Sign up at https://axiom.co - Free tier: 500GB ingestion/month, 30-day retention
# See specs/logging/axiom-setup-guide.md for detailed setup instructions
AXIOM_TOKEN=YOUR_AXIOM_API_TOKEN
AXIOM_DATASET=astro-basics

# Development Server Configuration
# Set to 'true' to expose dev server to all network interfaces (0.0.0.0)
# Leave unset or 'false' to restrict to localhost only (more secure)
# EXPOSE_DEV_SERVER=false

# Email (astro-email integration - see src/integrations/email/)
# Provider: postmark | sendgrid | mailgun. Leave unset to disable email entirely;
# sends then no-op and log at debug level rather than failing a request.
EMAIL_PROVIDER=YOUR_EMAIL_PROVIDER
EMAIL_PROVIDER_API_KEY=YOUR_EMAIL_PROVIDER_API_KEY
# Verified sender address. The provider must be authorised to send as this address.
EMAIL_FROM_ADDRESS=no-reply@yourdomain.com
# Where contact form notifications go. Unset means no notification is sent.
EMAIL_TO_ADDRESS=hello@yourdomain.com
# Mailgun only
# EMAIL_MAILGUN_DOMAIN=mg.yourdomain.com
# EMAIL_MAILGUN_REGION=us
